{
  "redirects": [
    {
      "source": "/impact-donations.html",
      "destination": "/about.html#giving",
      "permanent": true
    },
    {
      "source": "/impact-donations",
      "destination": "/about.html#giving",
      "permanent": true
    },
    {
      "source": "/impact-investments.html",
      "destination": "/about.html#investing",
      "permanent": true
    },
    {
      "source": "/impact-investments",
      "destination": "/about.html#investing",
      "permanent": true
    },
    {
      "source": "/preview-home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview-home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview-all.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview-all",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
